@prefix dprod: <https://ekgf.github.io/dprod/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> . # Added dcat prefix as it will be needed for property ranges
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ekgf.github.io/dprod/> a owl:Ontology ;
    rdfs:label "DPROD Vocabulary" ;
    rdfs:comment "A vocabulary for describing data products, their inputs, outputs, and lifecycle." ;
    owl:versionInfo "0.1.0" ;
    dct:description "A vocabulary for describing data products, their inputs, outputs, lifecycle, and associated API operations."@en ;
    dct:creator [ rdf:type foaf:Agent ; foaf:name "AI Agent" ] ; # Using "AI Agent" as placeholder
    dct:created "2024-07-30"^^xsd:date ;
    dct:modified "2024-07-30"^^xsd:date .

# Class Definitions

dprod:DataProduct a rdfs:Class ;
    rdfs:label "Data Product" ;
    rdfs:comment "Represents a data product with inputs, outputs, and processing logic." .

dprod:DataProductLifecycleStatus a rdfs:Class ;
    rdfs:label "Data Product Lifecycle Status" ;
    rdfs:comment "Represents the lifecycle status of a data product (e.g., Active, Inactive, Development). This could also be modeled as a set of individuals (e.g., dprod:ActiveStatus, dprod:DevelopmentStatus) rather than a class whose instances are given titles." .

# Property Definitions

dprod:inputDataset a owl:ObjectProperty ;
    rdfs:label "Input Dataset" ;
    rdfs:comment "Specifies an input dataset for a data product." ;
    rdfs:domain dprod:DataProduct ;
    rdfs:range dcat:Dataset .

dprod:outputDataset a owl:ObjectProperty ;
    rdfs:label "Output Dataset" ;
    rdfs:comment "Specifies an output dataset generated by a data product." ;
    rdfs:domain dprod:DataProduct ;
    rdfs:range dcat:Dataset .

dprod:hasLifecycleStatus a owl:ObjectProperty ;
    rdfs:label "Has Lifecycle Status"@en ;
    rdfs:comment "Links a data product to its current lifecycle status."@en ;
    rdfs:domain dprod:DataProduct ;
    rdfs:range dprod:DataProductLifecycleStatus .
