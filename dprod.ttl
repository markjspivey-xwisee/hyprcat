@prefix dprod: <https://ekgf.github.io/dprod/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> . # Added dcat prefix as it will be needed for property ranges

<https://ekgf.github.io/dprod/> a owl:Ontology ;
    rdfs:label "DPROD Vocabulary" ;
    rdfs:comment "A vocabulary for describing data products, their inputs, outputs, and lifecycle." .

# Class Definitions

dprod:DataProduct a rdfs:Class ;
    rdfs:label "Data Product" ;
    rdfs:comment "Represents a data product with inputs, outputs, and processing logic." .

dprod:DataProductLifecycleStatus a rdfs:Class ;
    rdfs:label "Data Product Lifecycle Status" ;
    rdfs:comment "Represents the lifecycle status of a data product." .

# Property Definitions

dprod:inputDataset a owl:ObjectProperty ;
    rdfs:label "Input Dataset" ;
    rdfs:comment "Specifies an input dataset for a data product." ;
    rdfs:domain dprod:DataProduct ;
    rdfs:range dcat:Dataset .

dprod:outputDataset a owl:ObjectProperty ;
    rdfs:label "Output Dataset" ;
    rdfs:comment "Specifies an output dataset generated by a data product." ;
    rdfs:domain dprod:DataProduct ;
    rdfs:range dcat:Dataset .
